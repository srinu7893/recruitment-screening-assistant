# Copy to .env, restrict permissions (chmod 600 .env), and replace placeholders.
# Use a dedicated Neon database for recruitment, not the payment application's database.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT-HOST.neon.tech/recruitment?sslmode=verify-full&channel_binding=require
SCREENING_PUBLIC_URL=https://recruitment.example.com
SCREENING_API_TOKEN=
SCREENING_PROVIDER=demo
# For live screening: SCREENING_PROVIDER=openai and configure both values below.
OPENAI_API_KEY=
OPENAI_MODEL=
SCREENING_RETENTION_DAYS=0
